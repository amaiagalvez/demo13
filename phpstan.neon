# PHPStan config that basics13 publishes to every application that uses it:
#   php artisan vendor:publish --tag=basics13-tooling [--force]
includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - resources/
        - routes/
        - tests/

    level: 9
