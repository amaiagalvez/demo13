{
    "servers": {
        "laravel-boost": {
            "command": "/usr/bin/docker",
            "args": [
                "compose",
                "exec",
                "-T",
                "-e",
                "XDEBUG_MODE=off",
                "laravel13",
                "php",
                "artisan",
                "boost:mcp"
            ]
        }
    }
}